#  ATOMCOLS.DEF
#  System file for :
#  Ortep-3 for Windows Version 2.0 (April 2008)
#
#
# File ATOMCOLS.DEF modifies the default colours for each element
#
# The default colour scheme in ORTEP is the  well known CPK scheme
# C = LightGrey O = Red H = White N = LightBlue S = Yellow
# P = Orange Cl = Green Br = Brown Na = Purple Zn = Brown
# metals = Gray75 unknown = Pink
#
# Users are free to modify any colour, but please ensure that the colour
# name corresponds either to an internally defined colour (see table in
# ORTEP3 manual) or one defined in RGBCOLS.DEF
#
